# Copy to .env for local development.
DATABASE_URL=postgresql://shelfiq:shelfiq@localhost:5433/shelfiq
# Optional: a read-only role for the AI analyst (see sql/readonly_role.sql)
# ANALYST_DATABASE_URL=
REDIS_URL=redis://localhost:6380/0

JWT_SECRET=dev-only-secret-change-me-in-production
CORS_ORIGINS=http://localhost:3000

# At least one key enables free-form AI questions. Suggested questions work without.
# Groq: https://console.groq.com/keys   Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
